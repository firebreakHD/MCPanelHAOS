{
	admin off
	default_sni {$PANEL_HOST}
	auto_https disable_redirects
	skip_install_trust
}

https://{$PANEL_HOST}:8443 {
	tls internal
	reverse_proxy 127.0.0.1:8080
}

http://:8099 {
	@supervisor remote_ip 172.30.32.2
	handle @supervisor {
		handle /ca.crt {
			root * /app/discopanel/caddy/caddy/pki/authorities/local
			rewrite * /root.crt
			header Content-Disposition "attachment; filename=MCPanelHAOS-CA.crt"
			file_server
		}
		handle {
			root * /app/discopanel/landing
			file_server
		}
	}
	respond 403
}
